# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/corpcommercialbank

# JWT Secret (Change this to a random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email Configuration (for OTP and Password Reset)

# Option 1: Gmail (may not work on Railway/Render)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Option 2: SendGrid (Recommended for production)
# Sign up at: https://sendgrid.com
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# Option 3: Custom SMTP
# EMAIL_SERVICE=custom
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# EMAIL_USER=your-email@domain.com
# EMAIL_PASSWORD=your-password

# Note: For Gmail, you need to use an App-Specific Password
# Generate it at: https://myaccount.google.com/apppasswords
