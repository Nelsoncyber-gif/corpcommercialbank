# ===========================================
# CORPCOMMERCIAL BANK - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and update the values

# -------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------
# For Local Development (Windows with PostgreSQL installed):
# Format: postgresql://username:password@host:port/database

# Option 1: Using default 'postgres' superuser
# Replace 'your-password' with the password you set during PostgreSQL installation
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/corpcommercialbank

# Option 2: Using a dedicated database user (recommended for development)
# DATABASE_URL=postgresql://bankuser:bankpassword@localhost:5432/corpcommercialbank

# For Production (Railway, Render, Supabase, etc.):
# Use the connection string provided by your hosting provider
# Example (Supabase): postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres
# Example (Railway): postgresql://user:password@host:port/database

# -------------------------------------------
# JWT SECRET
# -------------------------------------------
# IMPORTANT: Change this to a random string in production!
# Generate a random string: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-abc123xyz

# -------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# -------------------------------------------
# EMAIL CONFIGURATION (for OTP and Password Reset)
# -------------------------------------------

# Option 1: Gmail (for development)
# NOTE: You must use an App-Specific Password, not your regular password
# Generate it at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-char-app-specific-password

# Option 2: SendGrid (Recommended for production)
# Sign up at: https://sendgrid.com
# EMAIL_SERVICE=sendgrid
# SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Option 3: Custom SMTP
# EMAIL_SERVICE=custom
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# EMAIL_USER=your-email@domain.com
# EMAIL_PASSWORD=your-password

# -------------------------------------------
# CARD ENCRYPTION KEY (for card number encryption)
# -------------------------------------------
# Must be exactly 32 characters
CARD_ENCRYPTION_KEY=your-32-char-secret-key-here1234

# -------------------------------------------
# SETUP INSTRUCTIONS
# -------------------------------------------
# 1. Copy this file to .env
# 2. Update DATABASE_URL with your PostgreSQL credentials
# 3. Update JWT_SECRET with a random string
# 4. Update email configuration (optional for development)
# 5. Run: npm install
# 6. Run: npm run migrate:user-columns
# 7. Run: npm start
#
# To find your PostgreSQL password:
# - On Windows, check the password you set during installation
# - You can reset it with: 
#   "C:\Program Files\PostgreSQL\16\bin\psql.exe" -U postgres
#   ALTER USER postgres WITH PASSWORD 'new-password';
#
# To create the database:
#   "C:\Program Files\PostgreSQL\16\bin\createdb.exe" -U postgres corpcommercialbank
